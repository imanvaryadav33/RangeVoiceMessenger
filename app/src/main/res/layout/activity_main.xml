<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Range Voice Messenger"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Paired device chuno (dusra phone):"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <Spinner
        android:id="@+id/spinnerDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnRefreshDevices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paired devices refresh karo"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2. Message likho (jab dusra phone range me aayega, ye bolega):"
        android:textSize="14sp"
        android:layout_marginTop="20dp" />

    <EditText
        android:id="@+id/etMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Jaise: Bhaiya aa gaye ghar ke paas"
        android:minLines="2"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message Save Karo"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Service Start Karo"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2E7D32" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Service band hai"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        android:padding="12dp"
        android:background="#EEEEEE" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note: Dono phones me ye app install honi chahiye, aur Bluetooth Settings me ek dusre se pehle se paired honi chahiye."
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="16dp" />

</LinearLayout>
